{
  "ConnectionStrings": {
    "DefaultConnection": "Server=(localdb)\\ProjectModels;Database=SurveyBasketDb;Trusted_Connection=True;MultipleActiveResultSets=true"
  },

  "Serilog": {
    "MinimumLevel": {
      "Default": "Warning",
      "Override": {
        "Microsoft.AspNetCore": "Warning"
      }
    },
    "WriteTo": [
      {
        "Args": {
          "formatter": "Serilog.Formatting.Json.JsonFormatter"
        }
      }
      //{
      //  "Name": "File",
      //  "Args": {
      //    "path": "D:\\Logs\\log-.json",
      //    "rollingInterval": "Day",
      //    "formatter": "Serilog.Formatting.Compact.CompactJsonFormatter, Serilog.Formatting.Compact"
      //  }
      //}
    ]
  },


  "Jwt": {
    "Key": "",
    "Issuer": "SurveyBasketApi",
    "Audience": "SurveyBasketClient",
    "ExpiryMinutes": 60
  },

  "AllowedHosts": "*",

  "AllowedOrigins": [
    "http://localhost:3000",
    "https://localhost:3000"
  ]
}